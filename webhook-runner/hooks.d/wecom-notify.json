[
  {
    "id": "wecom-notify",
    "execute-command": "/hooks/scripts/wecom-notify.sh",
    "pass-environment-to-command": [
      { "source": "string", "envname": "WECOM_APP_KEY", "name": "wecom-notify" }
    ],
    "include-command-output-in-response": false,
    "pass-arguments-to-command": [
      { "source": "payload", "name": "pusher.name" },
      { "source": "payload", "name": "repository.full_name" },
      { "source": "payload", "name": "ref" },
      { "source": "payload", "name": "commits" },
      { "source": "payload", "name": "head_commit.message" },
      { "source": "payload", "name": "compare" }
    ],
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "CHANGE_ME_与GitHub仓库Webhook设置里相同的secret",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": { "source": "payload", "name": "ref" }
          }
        }
      ]
    }
  }
]
